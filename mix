#!/bin/bash
#
# Bash completion for Elixir's mix build tool.
# Per-project task caching with automatic invalidation via mix.lock checksums.

_mix_project_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    [[ -f "$dir/mix.exs" ]] && echo "$dir" && return 0
    dir="$(dirname "$dir")"
  done
  return 1
}

_mix_cache_file() {
  local hash
  hash=$(printf '%s' "$1" | md5sum 2>/dev/null || printf '%s' "$1" | md5)
  hash="${hash%% *}"
  echo "$HOME/.mix_tasks/$hash"
}

_mix_lock_checksum() {
  local lock="$1/mix.lock"
  [[ -f "$lock" ]] || return 1
  local sum
  sum=$(md5sum "$lock" 2>/dev/null || md5 "$lock")
  echo "${sum%% *}"
}

_mix_refresh_cache() {
  local project_root="$1" cache_file="$2"
  [[ -f "$HOME/.mix_tasks" ]] && rm "$HOME/.mix_tasks"
  mkdir -p "$HOME/.mix_tasks"
  local checksum
  checksum=$(_mix_lock_checksum "$project_root") || checksum="none"
  local tasks
  tasks=$(mix help 2>/dev/null | grep '^mix ' | awk '{print $2}' | sed 's/#//' | grep -v '^help$' | grep . | awk '{print length, $0}' | sort -n -s | cut -d' ' -f2-)
  { echo "$checksum"; echo "$tasks"; } > "$cache_file"
}

_mix_ensure_cache() {
  local project_root="$1" cache_file="$2"
  if [[ -f "$cache_file" ]]; then
    local stored current
    stored=$(head -1 "$cache_file")
    current=$(_mix_lock_checksum "$project_root") || current="none"
    [[ "$stored" == "$current" ]] && return 0
  fi
  _mix_refresh_cache "$project_root" "$cache_file"
}

_mix() {
  local cur
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"

  local project_root tasks
  if project_root=$(_mix_project_root); then
    local cache_file
    cache_file=$(_mix_cache_file "$project_root")
    _mix_ensure_cache "$project_root" "$cache_file"
    tasks=$(tail -n +2 "$cache_file")
  else
    tasks=$(mix help 2>/dev/null | grep '^mix ' | awk '{print $2}' | sed 's/#//' | grep -v '^help$' | grep .)
  fi

  COMPREPLY=($(compgen -W "$tasks" -- "$cur"))
  return 0
}

complete -F _mix mix
